# ============================================================
# DASH MEDIC CARE — variables de entorno
# Copia este archivo a .env para pruebas locales (netlify dev).
# En producción se capturan en Netlify: Site configuration → Environment variables.
# NUNCA subas el archivo .env a GitHub (ya está en .gitignore).
# ============================================================

# ---------- Stripe (empieza SIEMPRE con las llaves de prueba sk_test_) ----------
STRIPE_SECRET_KEY=sk_test_xxx
# Secreto de firma del webhook (whsec_...). En local lo da `stripe listen`.
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Price IDs de cada modalidad (Stripe → Catálogo de productos → precio → "price_...")
STRIPE_PRICE_MENSUAL=price_xxx
STRIPE_PRICE_TRIMESTRAL=price_xxx
STRIPE_PRICE_ANUAL=price_xxx
# Payment Links de prepago (los mismos que pegas en membresias.html). Se usan en el aviso de renovación.
STRIPE_LINK_TRIMESTRAL=https://buy.stripe.com/test_xxx
STRIPE_LINK_ANUAL=https://buy.stripe.com/test_xxx

# ---------- Google Sheets ----------
# JSON de la cuenta de servicio. Basta con {"client_email":"...","private_key":"..."}
# (recórtalo así para no pasar el límite de 4 KB de variables de las Functions).
# También se acepta el JSON codificado en base64.
GOOGLE_SERVICE_ACCOUNT_JSON={"client_email":"dash-pagos@tu-proyecto.iam.gserviceaccount.com","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"}
# ID de la hoja: lo que va entre /d/ y /edit en la URL. Usa una hoja distinta para pruebas.
SHEET_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---------- Correo (Resend) ----------
RESEND_API_KEY=re_xxx
# Remitente con dominio verificado en Resend
EMAIL_FROM=DASH MEDIC CARE <hola@dashmediccare.com>
EMAIL_REPLY_TO=hola@dashmediccare.com
# Destinatarios (puedes poner varios separados por coma). En pruebas usa tu propio correo.
EVERHEALTH_EMAIL=altas@everhealth.example
ADMIN_EMAIL=admin@dashmediccare.com

# ---------- Reglas de negocio ----------
# Código del líder de ventas (cobra tarifa de líder y la parte de líder sobre los demás vendedores)
LIDER_CODIGO=PAULO
# Afiliados corporativos activos en la bolsa Basic (hoy 201: Kruger + HiPICK)
CORPORATIVOS_ACTIVOS=201
# Tope de la bolsa Basic; al pasarlo se manda alerta a ADMIN_EMAIL
UMBRAL_BOLSA=450
# Opcional: sobrescribe las reglas de comisión (ver README → Comisiones). Ejemplo:
# COMISIONES_JSON={"prepago":{"mesesComisionables":{"trimestral":3,"anual":12}}}

# ---------- Facturación CFDI 4.0 (Facturapi) — apagada ----------
FACTURACION_ACTIVA=false
FACTURAPI_KEY=sk_test_xxx
# Clave de producto/servicio SAT y unidad. Confírmalas con tu contador antes de activar.
SAT_CLAVE_PRODUCTO=01010101
SAT_CLAVE_UNIDAD=E48
# Código postal del lugar de expedición (para la factura global)
LUGAR_EXPEDICION_CP=00000
# true = sólo se aceptan solicitudes de pagos del mes en curso (lo demás va a la factura global)
FACTURACION_SOLO_MES_EN_CURSO=true

# ---------- Sólo pruebas ----------
# Simula la fecha de "hoy" (AAAA-MM-DD) para probar avisos y vencimientos.
# Se ignora si STRIPE_SECRET_KEY no es de prueba.
# HOY_SIMULADO=2027-02-10
# URL pública del sitio para los enlaces de los correos (en Netlify se toma sola de URL)
# SITE_URL=http://localhost:8888
